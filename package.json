{
  "name": "arquetipoplaywright",
  "version": "1.0.0",
  "description": "This project contains automated tests for both API and UI layers using Playwright.",
  "main": "index.js",
  "scripts": {
  "test": "playwright test",


  "test:smoke": "playwright test --grep @smoke",
  "test:integration": "playwright test --grep @integration",
  "test:regression": "playwright test --grep @regression",
  "test:contract": "playwright test --grep @contract",
  "test:negative": "playwright test --grep @negative",
  
  "test:api": "playwright test --grep @api",
  "test:ui": "playwright test --grep @ui",
  
  "test:usuarios": "playwright test domains/usuarios",
  
  "test:ui-mode": "playwright test --ui",
  "test:headed": "playwright test --headed",
  "report": "playwright show-report",

  "test:usuarios:api": "playwright test domains/usuarios/api",
  "test:usuarios:smoke": "playwright test domains/usuarios --grep @smoke",
  "test:usuarios:integration": "playwright test domains/usuarios --grep @integration",
  "test:usuarios:regression": "playwright test domains/usuarios --grep @regression",
  "test:usuarios:contract": "playwright test domains/usuarios --grep @contract"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2"
  }
}
